---
// Cookie Consent HUD
// A futuristic, cyberpunk-style cookie consent component
---

<div
    id="cookie-hud"
    class="fixed bottom-4 right-4 z-50 max-w-sm w-[calc(100%-2rem)] opacity-0 translate-x-5 pointer-events-none"
    role="alertdialog"
    aria-labelledby="cookie-hud-title"
    aria-describedby="cookie-hud-desc"
>
    <!-- Glassmorphism Container -->
    <div
        class="bg-slate-900/90 backdrop-blur-md border border-cyan-500/30 rounded-lg shadow-[0_0_15px_rgba(6,182,212,0.15)] overflow-hidden relative"
    >
        <!-- Scanning Line Animation (Optional decorative element) -->
        <div
            class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-cyan-500/50 to-transparent animate-scan-line pointer-events-none"
        >
        </div>

        <!-- Header -->
        <div
            class="flex items-center justify-between px-4 py-3 border-b border-cyan-500/20 bg-black/20"
        >
            <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-cyan-500 rounded-full animate-pulse">
                </div>
                <h2
                    id="cookie-hud-title"
                    class="text-xs font-mono font-bold text-cyan-400 tracking-widest uppercase"
                >
                    SYSTEM NOTICE: DATA CONNECTION
                </h2>
            </div>
            <div class="text-[10px] font-mono text-cyan-500/50">v2.0</div>
        </div>

        <!-- Body -->
        <div class="p-5">
            <p
                id="cookie-hud-desc"
                class="text-sm text-gray-300 font-mono leading-relaxed mb-6"
            >
                MIRAIDO.netでは、プロジェクトの進化と体験の最適化のためにCookie技術を使用しています。あなたのプライバシーは暗号化され、保護されています。
            </p>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-3">
                <button
                    id="cookie-btn-accept"
                    class="flex-1 group relative px-4 py-2 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/50 hover:border-cyan-400 rounded transition-all duration-300 overflow-hidden"
                >
                    <div
                        class="absolute inset-0 bg-cyan-500/10 translate-y-[100%] group-hover:translate-y-0 transition-transform duration-300"
                    >
                    </div>
                    <span
                        class="relative font-mono text-xs font-bold tracking-wider uppercase flex items-center justify-center gap-2"
                    >
                        <span class="text-lg leading-none">›</span>
                        INITIALIZE [同意して接続]
                    </span>
                </button>

                <button
                    id="cookie-btn-reject"
                    class="flex-1 px-4 py-2 bg-transparent hover:bg-white/5 text-gray-500 hover:text-gray-300 border border-gray-700 hover:border-gray-500 rounded transition-colors duration-300"
                >
                    <span
                        class="font-mono text-xs font-bold tracking-wider uppercase"
                    >
                        RESTRICT [最小限]
                    </span>
                </button>
            </div>
        </div>

        <!-- Footer / Status -->
        <div
            class="px-4 py-1 bg-black/40 border-t border-white/5 flex justify-between items-center"
        >
            <span class="text-[10px] font-mono text-gray-600">
                STATUS: WAITING_FOR_INPUT
            </span>
            <span class="text-[10px] font-mono text-cyan-900/40">
                SECURE::ENCRYPTED
            </span>
        </div>
    </div>
</div>

<script>
    import { gsap } from "gsap";

    // --- Configuration ---
    const STORAGE_KEY = "miraido_consent_status";
    const HUD_SELECTOR = "#cookie-hud";
    const BTN_ACCEPT_SELECTOR = "#cookie-btn-accept";
    const BTN_REJECT_SELECTOR = "#cookie-btn-reject";
    const TRIGGER_BTN_SELECTOR = "#cookie-settings-trigger"; // ID for the re-open button

    declare global {
        interface Window {
            dataLayer: any[];
            gtag: (...args: any[]) => void;
        }
    }

    // --- Main Logic (Wrapped for View Transitions) ---
    const initCookieHud = () => {
        const hud = document.querySelector(HUD_SELECTOR) as HTMLElement;
        if (!hud) return;

        // --- Animations ---
        const showHud = (delay = 0) => {
            if (!hud) return;

            // Reset state if hidden
            hud.style.display = "block";
            hud.style.pointerEvents = "auto";

            // Kill existing animations to prevent conflicts
            gsap.killTweensOf(hud);

            gsap.to(hud, {
                x: 0,
                scale: 1,
                autoAlpha: 1, // opacity: 1, visibility: visible
                duration: 0.8,
                ease: "expo.out",
                delay: delay,
            });
        };

        const hideHud = () => {
            gsap.to(hud, {
                scale: 0.95,
                opacity: 0,
                duration: 0.5,
                ease: "power2.in",
                onComplete: () => {
                    if (hud) {
                        hud.style.display = "none";
                    }
                },
            });
        };

        // --- Consent Logic ---
        const setConsent = (status: "granted" | "denied") => {
            // 1. Save to LocalStorage
            localStorage.setItem(STORAGE_KEY, status);

            // 2. Trigger Google Consent Mode v2
            const consentUpdate = {
                ad_storage: status,
                ad_user_data: status,
                ad_personalization: status,
                analytics_storage: status,
            };

            if (typeof window.gtag === "function") {
                window.gtag("consent", "update", consentUpdate);
                console.log(`[MIRAIDO SYSTEM] Consent Mode updated: ${status}`);
            } else {
                console.log(
                    `[MIRAIDO SYSTEM] Mock GTag Update: ${status} (gtag not found)`,
                );
                window.dataLayer = window.dataLayer || [];
                function gtag(...args: any[]) {
                    window.dataLayer.push(args);
                }
                gtag("consent", "update", consentUpdate);
            }

            // 3. Animate Out
            hideHud();
        };

        // --- Initial Check ---
        const existingConsent = localStorage.getItem(STORAGE_KEY);
        if (!existingConsent) {
            // No choice made yet -> Show banner automatically
            showHud(1.5);
        } else {
            // Choice already made -> Ensure hidden
            // But we don't set display:none immediately here to allow re-open logic to potentially animate it in if triggered elsewhere (though unlikely on load)
            // Actually, for better UX, let's just make sure it's hidden if they consented.
            gsap.set(hud, { autoAlpha: 0, x: 20 });
        }

        // --- Event Listeners ---
        const btnAccept = document.querySelector(BTN_ACCEPT_SELECTOR);
        const btnReject = document.querySelector(BTN_REJECT_SELECTOR);
        const btnTrigger = document.querySelector(TRIGGER_BTN_SELECTOR);

        if (btnAccept) {
            // Remove old listener (not strictly necessary with plain new function scope but good practice)
            const newAccept = btnAccept.cloneNode(true);
            btnAccept.parentNode?.replaceChild(newAccept, btnAccept);
            newAccept.addEventListener("click", () => setConsent("granted"));
        }

        if (btnReject) {
            const newReject = btnReject.cloneNode(true);
            btnReject.parentNode?.replaceChild(newReject, btnReject);
            newReject.addEventListener("click", () => setConsent("denied"));
        }

        // Re-open Trigger (e.g. from Privacy Policy page)
        if (btnTrigger) {
            btnTrigger.addEventListener("click", (e) => {
                e.preventDefault();
                console.log("[MIRAIDO SYSTEM] Cookie Settings Re-opened");
                showHud(0); // Show immediately
            });
        }
    };

    // Run on initial load
    document.addEventListener("DOMContentLoaded", initCookieHud);

    // Support Astro View Transitions
    document.addEventListener("astro:page-load", initCookieHud);
</script>

<style>
    @keyframes scan-line {
        0% {
            transform: translateY(0);
            opacity: 0;
        }
        50% {
            opacity: 1;
        }
        100% {
            transform: translateY(200px);
            opacity: 0;
        }
    }
    .animate-scan-line {
        animation: scan-line 3s linear infinite;
    }
</style>
