---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieHud from "../components/ui/CookieHud.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	type?: "website" | "article";
	image?: string;
	publishedAt?: string;
}

const { title, description, type, image, publishedAt } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<Seo
			title={title}
			description={description}
			type={type}
			image={image}
			publishedAt={publishedAt}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-primary text-text antialiased relative">
		<Header />
		<!-- Day-Night Cycle Background -->
		<div
			class="fixed inset-0 z-[-1] pointer-events-none animate-day-night-cycle"
		>
		</div>
		<slot />
		<Footer />
		<CookieHud />
	</body>
</html>

<script>
	import Lenis from "lenis";
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	// Initialize Lenis
	const lenis = new Lenis({
		duration: 1.2,
		easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
		orientation: "vertical",
		gestureOrientation: "vertical",
		smoothWheel: true,
	});

	// Connect Lenis to GSAP ScrollTrigger
	gsap.registerPlugin(ScrollTrigger);

	lenis.on("scroll", ScrollTrigger.update);

	gsap.ticker.add((time) => {
		lenis.raf(time * 1000);
	});

	gsap.ticker.lagSmoothing(0);

	// Optional: Expose lenis instance globally if needed for other scripts
	(window as any).lenis = lenis;

	// Add 'lenis' class to html for CSS targeting
	document.documentElement.classList.add("lenis");
</script>

<style>
	@keyframes day-night-cycle {
		0% {
			background: linear-gradient(
				to bottom,
				#020617,
				#0f172a,
				#1e293b
			); /* Deep Night */
		}
		25% {
			background: linear-gradient(
				to bottom,
				#0f172a,
				#334155,
				#fca5a5
			); /* Sunrise (Morning Glow) */
		}
		50% {
			background: linear-gradient(
				to bottom,
				#1e293b,
				#475569,
				#cbd5e1
			); /* Day / Cloudy Bright */
		}
		75% {
			background: linear-gradient(
				to bottom,
				#1e1b4b,
				#5b21b6,
				#fb923c
			); /* Sunset (Evening Glow) */
		}
		100% {
			background: linear-gradient(
				to bottom,
				#020617,
				#0f172a,
				#1e293b
			); /* Deep Night */
		}
	}

	.animate-day-night-cycle {
		animation: day-night-cycle 60s infinite linear;
		background-size: 400% 400%; /* Enhances the gradient shift effect */
	}
</style>
