---
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	type?: "website" | "article";
	image?: string;
	publishedAt?: string;
}

const { title, description, type, image, publishedAt } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<Seo
			title={title}
			description={description}
			type={type}
			image={image}
			publishedAt={publishedAt}
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Zen+Old+Mincho:wght@900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-primary text-text antialiased relative">
		<Header />
		<!-- Day-Night Cycle Background -->
		<div
			class="fixed inset-0 z-[-1] pointer-events-none animate-day-night-cycle"
		>
		</div>
		<slot />
		<Footer />
	</body>
</html>

<script>
	import Lenis from "lenis";

	const lenis = new Lenis();

	function raf(time: number) {
		lenis.raf(time);
		requestAnimationFrame(raf);
	}

	requestAnimationFrame(raf);
</script>

<style>
	@keyframes day-night-cycle {
		0% {
			background: linear-gradient(
				to bottom,
				#020617,
				#0f172a,
				#1e293b
			); /* Deep Night */
		}
		25% {
			background: linear-gradient(
				to bottom,
				#0f172a,
				#334155,
				#fca5a5
			); /* Sunrise (Morning Glow) */
		}
		50% {
			background: linear-gradient(
				to bottom,
				#1e293b,
				#475569,
				#cbd5e1
			); /* Day / Cloudy Bright */
		}
		75% {
			background: linear-gradient(
				to bottom,
				#1e1b4b,
				#5b21b6,
				#fb923c
			); /* Sunset (Evening Glow) */
		}
		100% {
			background: linear-gradient(
				to bottom,
				#020617,
				#0f172a,
				#1e293b
			); /* Deep Night */
		}
	}

	.animate-day-night-cycle {
		animation: day-night-cycle 60s infinite linear;
		background-size: 400% 400%; /* Enhances the gradient shift effect */
	}
</style>
