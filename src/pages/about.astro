---
import Layout from "../layouts/Layout.astro";
import DragonAnimation from "../components/DragonAnimation.astro";
---

<Layout
    title="MIRAIDO | プロジェクトについて"
    description="MIRAIDOプロジェクトの理念、活動内容、運営団体についてをご紹介します。"
>
    <!-- Full-screen Background Animation -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <DragonAnimation />
    </div>

    <main class="relative z-10 min-h-screen py-24 px-4 overflow-hidden">
        <div class="container mx-auto max-w-4xl">
            <!-- Header -->
            <header class="text-center mb-24 opacity-0 animate-fade-in-up">
                <h1
                    class="text-4xl md:text-6xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-accent mb-6"
                >
                    ABOUT US
                </h1>
                <p class="text-lg md:text-xl text-gray-300 font-light">
                    MIRAIDOプロジェクトについて
                </p>
            </header>

            <!-- Mission / Vision -->
            <section class="mb-32 opacity-0 animate-fade-in-up delay-100">
                <div class="text-center space-y-12">
                    <h2 class="text-3xl md:text-4xl font-bold text-white">
                        過去から未来へ、<br />
                        <span class="text-accent">道</span>をつなぐ
                    </h2>
                    <p class="text-gray-300 leading-loose text-lg">
                        世界遺産「熊野古道」が息づく東紀州。<br />
                        古来より人々が祈りを捧げ、歩んできたこの「道」は、<br />
                        過去と現在をつなぐ架け橋です。
                    </p>
                    <p class="text-gray-300 leading-loose text-lg">
                        私たち<span class="font-bold text-teal-400"
                            >MIRAIDO</span
                        >は、<br />
                        その歴史的な精神を受け継ぎながら、<br />
                        テクノロジーの力で「未来への道」を切り拓きます。
                    </p>
                    <p class="text-gray-300 leading-loose text-lg">
                        子供たちの無限の好奇心を羅針盤に。<br />
                        AIとロボットという新たな航海術を手に。<br />
                        ここから世界へ、そして未来へと続く冒険が始まります。
                    </p>
                </div>
            </section>

            <!-- 3 Pillars -->
            <section class="mb-32">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Education -->
                    <div
                        class="bg-slate-900/60 backdrop-blur-md rounded-2xl p-8 border border-white/10 opacity-0 animate-fade-in-up delay-200 hover:border-accent/40 transition-colors group"
                    >
                        <div
                            class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300"
                        >
                            🎓
                        </div>
                        <h3 class="text-xl font-bold text-white mb-4">
                            次世代教育
                        </h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            ロボットプログラミングやAI活用講座を通じて、子供たちの論理的思考力と創造性を育みます。「楽しむ」ことから始まる学びを提供します。
                        </p>
                    </div>
                    <!-- Region -->
                    <div
                        class="bg-slate-900/60 backdrop-blur-md rounded-2xl p-8 border border-white/10 opacity-0 animate-fade-in-up delay-300 hover:border-accent/40 transition-colors group"
                    >
                        <div
                            class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300"
                        >
                            🌏
                        </div>
                        <h3 class="text-xl font-bold text-white mb-4">
                            地域活性化
                        </h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            地方都市の課題解決にテクノロジーで挑みます。地域資源とデジタルを融合させ、新たな価値と雇用を創出するエコシステムを目指します。
                        </p>
                    </div>
                    <!-- Technology -->
                    <div
                        class="bg-slate-900/60 backdrop-blur-md rounded-2xl p-8 border border-white/10 opacity-0 animate-fade-in-up delay-400 hover:border-accent/40 transition-colors group"
                    >
                        <div
                            class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300"
                        >
                            🤖
                        </div>
                        <h3 class="text-xl font-bold text-white mb-4">
                            先端技術の実装
                        </h3>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            最先端のAI・ロボティクス技術を、実社会のフィールドで検証・実装します。未来の技術者が育つ土壌を、この地で作ります。
                        </p>
                    </div>
                </div>
            </section>

            <!-- Organization Overview -->
            <section class="mb-24 opacity-0 animate-fade-in-up delay-500">
                <h2
                    class="text-2xl font-bold text-white mb-8 text-center border-b border-white/10 pb-4 inline-block w-full"
                >
                    プロジェクト概要
                </h2>
                <div
                    class="bg-slate-900/80 backdrop-blur-md rounded-2xl p-8 md:p-12 border border-white/10"
                >
                    <table
                        class="w-full text-left text-gray-300 border-collapse"
                    >
                        <tbody>
                            <tr class="border-b border-white/10">
                                <th
                                    class="py-6 pr-8 font-bold text-white w-1/3 align-top"
                                    >プロジェクト名</th
                                >
                                <td class="py-6">MIRAIDOプロジェクト</td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <th
                                    class="py-6 pr-8 font-bold text-white align-top"
                                    >運営主体</th
                                >
                                <td class="py-6"> MIRAIDO実行委員会 </td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <th
                                    class="py-6 pr-8 font-bold text-white align-top"
                                    >設立</th
                                >
                                <td class="py-6">2025年1月</td>
                            </tr>
                            <tr class="border-b border-white/10">
                                <th
                                    class="py-6 pr-8 font-bold text-white align-top"
                                    >活動拠点</th
                                >
                                <td class="py-6">三重・奈良・和歌山</td>
                            </tr>
                            <tr>
                                <th
                                    class="py-6 pr-8 font-bold text-white align-top"
                                    >事業内容</th
                                >
                                <td class="py-6">
                                    <ul class="list-disc list-inside space-y-2">
                                        <li>
                                            ロボット大会・アプリコンテストの開催
                                        </li>
                                        <li>
                                            プログラミングワークショップの実施
                                        </li>
                                        <li>AIアートワークショップの実施</li>
                                        <li>地域課題解決型ハッカソンの開催</li>
                                        <li>教育機関へのカリキュラム提供</li>
                                    </ul>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Back Link -->
            <div
                class="mt-12 text-center opacity-0 animate-fade-in-up delay-600"
            >
                <div class="flex flex-col gap-4 justify-center items-center">
                    <a
                        href="/contact"
                        class="inline-block px-12 py-4 bg-gradient-to-r from-accent to-blue-600 text-white font-bold rounded-full hover:shadow-lg transition-all duration-300"
                    >
                        お問い合わせはこちら
                    </a>
                    <a
                        href="/"
                        class="text-gray-500 hover:text-white transition-colors underline decoration-dotted text-sm"
                        >Home</a
                    >
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";

    gsap.to(".animate-fade-in-up", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
    });
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
</style>
