---
import Layout from "../../layouts/Layout.astro";
import DragonAnimation from "../../components/DragonAnimation.astro";
import { getBlogs, getBlogDetail } from "../../lib/microcms";
import type { Blog } from "../../types/microcms";

// Static Paths
export async function getStaticPaths() {
    const { contents: blogs } = await getBlogs();
    const paths =
        blogs && blogs.length > 0
            ? blogs.map((item) => ({ params: { slug: item.id } }))
            : [
                  { params: { slug: "1" } },
                  { params: { slug: "2" } },
                  { params: { slug: "3" } },
                  { params: { slug: "4" } },
              ];
    return paths;
}

const { slug } = Astro.params;
const blog = await getBlogDetail(slug as string);

// Mock data
const displayBlog =
    blog ||
    ({
        id: slug,
        title: "子供たちの「未来への扉」を開くために",
        category: [
            { id: "c1", name: "理念" },
            { id: "c2", name: "教育" } as any,
        ],
        content:
            "<p>私たちは、子供たちが自らの可能性を信じ、未来を切り拓いていく力を育むことを目指しています。</p><h3>MIRAIDOの理念</h3><p>失敗を恐れずに挑戦すること、そして仲間と協力して課題を解決すること。これらの経験が、次世代のリーダーを育てます。</p>",
        publishedAt: "2025-04-10",
        thumbnail: { url: "" },
    } as Blog);
---

<Layout
    title={`${displayBlog.title} | BLOG | MIRAIDO`}
    description="MIRAIDO 活動レポート"
>
    <div class="fixed inset-0 z-0 pointer-events-none">
        <DragonAnimation />
    </div>

    <main class="relative z-10 min-h-screen py-24 px-4">
        <div class="container mx-auto max-w-3xl">
            <!-- Header -->
            <header class="mb-12 opacity-0 animate-fade-in-up text-center">
                <div
                    class="flex items-center justify-center gap-4 mb-6 text-sm md:text-base font-mono"
                >
                    <time
                        class="text-accent/80"
                        datetime={displayBlog.publishedAt}
                    >
                        {
                            new Date(
                                displayBlog.publishedAt,
                            ).toLocaleDateString("ja-JP")
                        }
                    </time>
                    <div class="flex gap-2">
                        {
                            (Array.isArray(displayBlog.category)
                                ? displayBlog.category
                                : displayBlog.category
                                  ? [displayBlog.category]
                                  : []
                            ).map((cat: any) => (
                                <span class="px-2 py-0.5 rounded text-xs border border-white/20 bg-white/5 text-gray-300">
                                    {cat.name}
                                </span>
                            ))
                        }
                    </div>
                </div>
                <h1
                    class="text-3xl md:text-5xl font-bold text-white leading-tight mb-8"
                >
                    {displayBlog.title}
                </h1>

                {
                    displayBlog.thumbnail ? (
                        <div class="rounded-2xl overflow-hidden shadow-2xl shadow-accent/10 border border-white/10 aspect-[16/9]">
                            <img
                                src={displayBlog.thumbnail.url}
                                alt={displayBlog.title}
                                class="w-full h-full object-cover"
                            />
                        </div>
                    ) : (
                        <div class="rounded-2xl overflow-hidden shadow-2xl shadow-accent/10 border border-white/10 aspect-[16/9] bg-slate-800 flex items-center justify-center text-6xl text-white/10">
                            📝
                        </div>
                    )
                }
            </header>

            <!-- Content -->
            <article
                class="prose prose-invert prose-lg max-w-none opacity-0 animate-fade-in-up delay-200 bg-slate-900/40 p-8 md:p-12 rounded-2xl border border-white/5 backdrop-blur-sm"
            >
                <div set:html={displayBlog.content} />
            </article>

            <!-- Footer Navigation -->
            <div
                class="mt-20 text-center opacity-0 animate-fade-in-up delay-500"
            >
                <a
                    href="/blogs"
                    class="inline-flex items-center px-8 py-3 rounded-full border border-white/20 hover:bg-white/10 transition-colors text-sm font-bold tracking-widest gap-2 group"
                >
                    <span
                        class="transform group-hover:-translate-x-1 transition-transform"
                        >←</span
                    >
                    一覧に戻る
                </a>
            </div>
        </div>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";
    const items = document.querySelectorAll(".animate-fade-in-up");
    if (items.length > 0) {
        gsap.to(items, {
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.1,
            ease: "power3.out",
        });
    }
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
    :global(.prose h2) {
        color: #0ea5e9;
        border-left: 4px solid #0ea5e9;
        padding-left: 1rem;
        margin-top: 3rem;
    }
</style>
