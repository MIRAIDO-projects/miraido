---
import Layout from "../../layouts/Layout.astro";
import DragonAnimation from "../../components/DragonAnimation.astro";
import ContactForm from "../../components/ContactForm.astro";

const title = "CONTACT | MIRAIDO";
const description = "MIRAIDOプロジェクトへのお問い合わせはこちらから。";
---

<Layout title={title} description={description}>
    <!-- Full-screen Background Animation -->
    <div class="fixed inset-0 z-0">
        <DragonAnimation />
    </div>

    <main
        class="relative z-10 min-h-screen py-24 px-4 overflow-hidden flex items-center justify-center"
    >
        <div class="container mx-auto max-w-3xl">
            <!-- Header -->
            <header class="text-center mb-12 opacity-0 animate-fade-in-up">
                <h1
                    class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-accent mb-6"
                >
                    CONTACT
                </h1>
                <p class="text-lg text-gray-300 font-light">お問い合わせ</p>
            </header>

            <!-- Contact Form -->
            <div class="opacity-0 animate-fade-in-up delay-100">
                <ContactForm />
            </div>

            <!-- Back Link -->
            <div
                class="mt-12 text-center opacity-0 animate-fade-in-up delay-200"
            >
                <a
                    href="/"
                    class="text-gray-500 hover:text-white transition-colors underline decoration-dotted"
                    >Home</a
                >
            </div>
        </div>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";

    gsap.to(".animate-fade-in-up", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
    });
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
</style>
