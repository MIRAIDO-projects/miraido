---
import Layout from "../../layouts/Layout.astro";
import DragonAnimation from "../../components/DragonAnimation.astro";

const title = "SPONSOR CONTACT | MIRAIDO";
const description =
    "MIRAIDOプロジェクトへの協賛・スポンサーに関するお問い合わせはこちらから。";
---

<Layout title={title} description={description}>
    <!-- Full-screen Background Animation -->
    <div class="fixed inset-0 z-0">
        <DragonAnimation />
    </div>

    <main
        class="relative z-10 min-h-screen py-24 px-4 overflow-hidden flex items-center justify-center"
    >
        <div class="container mx-auto max-w-3xl">
            <!-- Header -->
            <header class="text-center mb-12 opacity-0 animate-fade-in-up">
                <h1
                    class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-accent mb-6"
                >
                    SPONSOR CONTACT
                </h1>
                <p class="text-lg text-gray-300 font-light">
                    協賛・スポンサーシップに関するお問い合わせ・お申し込み
                </p>
            </header>

            <!-- Contact Form -->
            <div
                class="bg-slate-900/60 border border-white/5 backdrop-blur-md rounded-3xl p-8 md:p-12 shadow-2xl opacity-0 animate-fade-in-up delay-100"
            >
                <form
                    action="https://hyperform.jp/api/TpjlHhrU"
                    method="POST"
                    class="space-y-8"
                >
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label
                                for="company"
                                class="block text-sm font-bold text-gray-400 mb-2"
                                >貴社名 / 団体名 <span class="text-accent"
                                    >*</span
                                ></label
                            >
                            <input
                                type="text"
                                id="company"
                                name="company"
                                required
                                class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
                                placeholder="株式会社MIRAIDO"
                            />
                        </div>
                        <div>
                            <label
                                for="name"
                                class="block text-sm font-bold text-gray-400 mb-2"
                                >担当者名 <span class="text-accent">*</span
                                ></label
                            >
                            <input
                                type="text"
                                id="name"
                                name="name"
                                required
                                class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
                                placeholder="未来 太郎"
                            />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-4">
                            <div>
                                <label
                                    for="email"
                                    class="block text-sm font-bold text-gray-400 mb-2"
                                    >メールアドレス <span class="text-accent"
                                        >*</span
                                    ></label
                                >
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    required
                                    class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
                                    placeholder="contact@example.com"
                                />
                            </div>
                            <div>
                                <label
                                    for="email_confirm"
                                    class="block text-sm font-bold text-gray-400 mb-2"
                                    >メールアドレス（確認） <span
                                        class="text-accent">*</span
                                    ></label
                                >
                                <input
                                    type="email"
                                    id="email_confirm"
                                    name="email_confirm"
                                    required
                                    class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
                                    placeholder="contact@example.com"
                                    oninput="checkEmailMatchSponsor()"
                                />
                                <p
                                    id="email-error-sponsor"
                                    class="text-red-500 text-xs mt-1 hidden"
                                >
                                    メールアドレスが一致しません。
                                </p>
                            </div>
                        </div>
                        <div>
                            <label
                                for="phone"
                                class="block text-sm font-bold text-gray-400 mb-2"
                                >電話番号</label
                            >
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
                                placeholder="03-1234-5678"
                            />
                        </div>
                    </div>

                    <div>
                        <label
                            for="plan"
                            class="block text-sm font-bold text-gray-400 mb-2"
                            >ご検討中のプラン（任意）</label
                        >
                        <select
                            id="plan"
                            name="plan"
                            class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors appearance-none"
                        >
                            <option value="" disabled selected
                                >選択してください</option
                            >
                            <option value="Platinum"
                                >PLATINUM (¥500,000~)</option
                            >
                            <option value="Gold">GOLD (¥100,000~)</option>
                            <option value="Silver">SILVER (¥50,000~)</option>
                            <option value="Personal">PERSONAL (¥10,000~)</option
                            >
                            <option value="Other">その他 / 未定</option>
                        </select>
                    </div>

                    <div>
                        <label
                            for="message"
                            class="block text-sm font-bold text-gray-400 mb-2"
                            >お問い合わせ内容 <span class="text-accent">*</span
                            ></label
                        >
                        <textarea
                            id="message"
                            name="message"
                            required
                            rows="5"
                            class="w-full bg-slate-900/80 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent transition-colors"
                            placeholder="協賛に関するご質問やご相談内容をご記入ください"
                        ></textarea>
                    </div>

                    <div class="text-center pt-4">
                        <button
                            type="submit"
                            class="inline-block px-12 py-4 bg-gradient-to-r from-teal-400 to-accent text-white font-bold text-lg rounded-full hover:shadow-[0_0_30px_rgba(14,165,233,0.5)] transition-all duration-300 transform hover:scale-105"
                        >
                            送信する
                        </button>
                    </div>
                </form>
            </div>
            <div
                class="mt-12 text-center opacity-0 animate-fade-in-up delay-200"
            >
                <a
                    href="/sponsor"
                    class="text-gray-500 hover:text-white transition-colors underline decoration-dotted"
                    >SPONSOR"0"ページに戻る</a
                >
            </div>
        </div>
    </main>
</Layout>

<script is:inline>
    function checkEmailMatchSponsor() {
        const email = document.getElementById("email");
        const emailConfirm = document.getElementById("email_confirm");
        const error = document.getElementById("email-error-sponsor");
        const submitBtn = document.querySelector('button[type="submit"]');

        if (email.value !== emailConfirm.value) {
            error.classList.remove("hidden");
            emailConfirm.classList.add("border-red-500");
            submitBtn.disabled = true;
            submitBtn.classList.add("opacity-50", "cursor-not-allowed");
        } else {
            error.classList.add("hidden");
            emailConfirm.classList.remove("border-red-500");
            submitBtn.disabled = false;
            submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        }
    }
</script>

<script>
    import { gsap } from "gsap";

    gsap.to(".animate-fade-in-up", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
    });
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
</style>
