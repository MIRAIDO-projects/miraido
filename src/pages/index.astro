                                <a href="https://line.me/R/ti/p/@362twwoz?oat__id=5380524" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-3 bg-[#06C755] text-white font-bold rounded-full hover:bg-[#05b34c] transition-colors shadow-lg shadow-[#06C755]/20">
