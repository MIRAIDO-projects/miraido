                            <a href="/contact" class="inline-flex items-center gap-2 px-8 py-3 bg-gradient-to-r from-teal-400 to-accent text-white font-bold rounded-full hover:shadow-[0_0_20px_rgba(14,165,233,0.5)] transition-all transform hover:scale-105">
