<script>
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	// MotionPathPlugin is now registered inside DragonAnimation.astro or globally if needed.
	// Registering here again for local scripts is fine/safe.

	gsap.registerPlugin(ScrollTrigger);

	// Helper to split text into spans
	function splitTextToSpans(selector: string) {
		const element = document.querySelector(selector) as HTMLElement; // Cast to HTMLElement to access style
		if (element && element.textContent) {
			const text = element.textContent.trim();
			element.textContent = "";
			// Process text to keep spaces
			[...text].forEach((char) => {
				const span = document.createElement("span");
				span.textContent = char;
				span.style.opacity = "0";
				span.style.display = "inline-block";
				if (char === " ") {
					span.style.width = "0.5em"; // manual space width
				}
				element.appendChild(span);
			});
			element.style.opacity = "1"; // Make container visible
		}
	}

	// Hero Animations
	const tl = gsap.timeline();

	// Prepare text
	splitTextToSpans(".hero-subtitle-en");

	// Text Animations
	// Remove old hero-title animation
	gsap.set(".hero-title", { opacity: 0 }); // Ensure hidden initially

	// Intro Title Sequence
	const titleTl = gsap.timeline();

	// 1. KODO appears (falls from top) and fades out (continuing down)
	titleTl
		.fromTo(
			".intro-word-1",
			{ y: -100, opacity: 0, filter: "blur(10px)" }, // Start from above
			{
				duration: 1.2,
				y: 0,
				opacity: 1,
				filter: "blur(0px)", // Clear text
				ease: "power3.out",
			},
		)
		.to(
			".intro-word-1",
			{
				duration: 0.8,
				opacity: 0,
				y: 50, // Continue falling down
				filter: "blur(5px)", // Slight motion blur on exit
				ease: "power2.in",
			},
			"+=0.5",
		) // Hold time

		// 2. TO appears
		.fromTo(
			".intro-word-2",
			{ y: -100, opacity: 0, filter: "blur(10px)" },
			{
				duration: 1.0,
				y: 0,
				opacity: 1,
				filter: "blur(0px)", // Clear text
				ease: "power3.out",
			},
			"-=0.2",
		)
		.to(
			".intro-word-2",
			{
				duration: 0.8,
				opacity: 0,
				y: 50, // Continue falling down
				filter: "blur(5px)",
				ease: "power2.in",
			},
			"+=0.5",
		)

		// 3. MIRAIDO appears
		.fromTo(
			".intro-word-3",
			{ y: -100, opacity: 0, filter: "blur(10px)" },
			{
				duration: 1.2,
				y: 0,
				opacity: 1,
				filter: "blur(0px)", // Clear text
				ease: "power3.out",
			},
			"-=0.2",
		)
		.to(
			".intro-word-3",
			{
				duration: 0.8,
				opacity: 0,
				y: 50, // Continue falling down
				filter: "blur(5px)",
				ease: "power2.in",
			},
			"+=0.5",
		)

		// 4. Final MIRAIDO appears
		.to(
			".hero-title",
			{
				duration: 2.0,
				opacity: 1,
				scale: 1,
				ease: "power4.out",
				backgroundPosition: "200% center",
				onStart: () => {
					gsap.set(".intro-sequence", { display: "none" });
				},
			},
			"-=0.2",
		);

	// Subtitle Animation (chained after title)
	titleTl
		.to(
			".hero-subtitle-en span",
			{
				duration: 0.8,
				opacity: 1,
				y: 0,
				stagger: 0.05,
				ease: "power3.out",
			},
			"-=1",
		)
		.to(
			".hero-cta",
			{
				duration: 1,
				opacity: 1,
				y: 0,
				ease: "power3.out",
			},
			"-=0.4",
		);

	// Link the title timeline to the main timeline if needed, or just let it run
	// Since we are replacing the main 'tl' logic for text, this is fine as 'titleTl'

	// Vertical Text Animation (Kodo -> Miraido) - Independent Timeline
	const textTl = gsap.timeline({ repeat: -1, repeatDelay: 2 });

	// Initial State
	gsap.set(".vertical-text", {
		opacity: 0,
		scale: 0.9,
		filter: "blur(10px)",
	});

	// Kodo appears (Vermilion color)
	textTl
		.to(".kodo", {
			duration: 2,
			opacity: 0.12, // 88% Transparency
			color: "#d74a39", // Traditional Vermilion (Shu-iro)
			scale: 1,
			filter: "blur(0px)",
			ease: "power2.out",
		})
		.to(
			".kodo",
			{
				duration: 2,
				opacity: 0,
				scale: 1.1,
				filter: "blur(20px)",
				ease: "power2.in",
			},
			"+=2",
		)

		// Miraido appears (White/Silver/Gold random cycle)
		.to(
			".miraido",
			{
				duration: 2,
				opacity: 0.12, // 88% Transparency
				scale: 1,
				filter: "blur(0px)",
				ease: "power2.out",
				onStart: () => {
					// Start randomized color shift loop for Miraido while it's visible
					gsap.to(".miraido", {
						color: "random(['#ffffff', '#e2e8f0', '#fbbf24'])", // White, Silver (slate-200), Gold (amber-400)
						duration: 0.5,
						repeat: 8, // Run during the visible time
						repeatRefresh: true,
						ease: "none",
					});
				},
			},
			"-=1",
		)
		.to(
			".miraido",
			{
				duration: 2,
				opacity: 0,
				scale: 1.1,
				filter: "blur(20px)",
				ease: "power2.in",
			},
			"+=3",
		);

    // "What is MIRAIDO" Section Animation
	const whatSection = document.querySelector("#what");
	if (whatSection) {
		gsap.to(".what-content", {
			scrollTrigger: {
				trigger: "#what",
				start: "top 70%",
			},
			opacity: 1,
			duration: 1,
		});

		gsap.to(".what-text", {
			scrollTrigger: {
				trigger: "#what",
				start: "top 70%",
			},
			y: 0,
			opacity: 1,
			duration: 1,
			stagger: 0.2, // Stagger ease text block
			ease: "power3.out",
		});
	}

    // Projects Section Animation
    const output = document.querySelector("#projects");
    if(output) {
        gsap.to(".project-header", {
            scrollTrigger: {
                trigger: "#projects",
                start: "top 70%",
            },
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power3.out"
        });

        gsap.to(".project-card", {
            scrollTrigger: {
                trigger: "#projects",
                start: "top 70%",
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.2,
            ease: "power3.out"
        });

        gsap.to(".project-footer", {
            scrollTrigger: {
                trigger: "#projects",
                start: "top 80%",
            },
            opacity: 1,
            y: 0,
            duration: 1,
            delay: 0.5,
            ease: "power3.out"
        });
    }

    // Sponsor Section Animation
    const sponsorOutput = document.querySelector("#sponsor");
    if(sponsorOutput) {
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#sponsor",
                start: "top 70%",
            }
        });

        tl.to(".sponsor-header", { y: 0, opacity: 1, duration: 1, ease: "power3.out" })
          .to(".sponsor-logos", { y: 0, opacity: 1, duration: 1, ease: "power3.out" }, "-=0.5")
          .to(".sponsor-cta", { y: 0, opacity: 1, duration: 0.8, ease: "power3.out" }, "-=0.5");
        
        // Initial setup for timeline targets handled in CSS usually, but ensuring here if needed
        gsap.set([".sponsor-header", ".sponsor-logos", ".sponsor-cta"], { y: 30 });
    }

    // Contact Section Animation
    const contactOutput = document.querySelector("#contact");
    if(contactOutput) {
        gsap.fromTo(".contact-content", 
            { y: 30, opacity: 0 },
            {
                scrollTrigger: {
                    trigger: "#contact",
                    start: "top 70%",
                },
                y: 0,
                opacity: 1,
                duration: 1,
                ease: "power3.out"
            }
        );
    }

    // Blog Section Animation
    const blogsOutput = document.querySelector("#blogs");
    if(blogsOutput) {
         gsap.to(".blog-header", {
            scrollTrigger: {
                trigger: "#blogs",
                start: "top 70%",
            },
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power3.out"
        });

        gsap.to(".blog-card", {
            scrollTrigger: {
                trigger: "#blogs",
                start: "top 70%",
            },
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.15,
            ease: "power3.out"
        });

         gsap.to(".blog-footer", {
            scrollTrigger: {
                trigger: "#blogs",
                start: "top 80%",
            },
            opacity: 1,
            y: 0,
            duration: 1,
            delay: 0.5,
            ease: "power3.out"
        });
    }


</script>

<style>
	/* Custom animations that simple Tailwind config might not cover */
	@keyframes pulse-slow {
		0%,
		100% {
			opacity: 0.3;
			transform: scale(1);
		}
		50% {
			opacity: 0.5;
			transform: scale(1.1);
		}
	}
	.animate-pulse-slow {
		animation: pulse-slow 8s infinite ease-in-out;
	}
</style>
