---
import Layout from "../layouts/Layout.astro";
import DragonAnimation from "../components/DragonAnimation.astro";
---

<Layout
    title="MIRAIDO | 特定商取引法に基づく表記"
    description="特定商取引法に基づく表記。"
>
    <!-- Full-screen Background Animation -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <DragonAnimation />
    </div>

    <main class="relative z-10 min-h-screen py-24 px-4 overflow-hidden">
        <div class="container mx-auto max-w-4xl">
            <!-- Header -->
            <header class="text-center mb-16 opacity-0 animate-fade-in-up">
                <h1
                    class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-accent mb-6"
                >
                    LEGAL
                </h1>
                <p class="text-gray-400">特定商取引法に基づく表記</p>
            </header>

            <!-- Content -->
            <div
                class="bg-slate-900/80 backdrop-blur-md rounded-2xl p-8 md:p-12 border border-white/10 opacity-0 animate-fade-in-up delay-100"
            >
                <table class="w-full text-left text-gray-300 border-collapse">
                    <tbody>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white w-1/3"
                                >販売業者</th
                            >
                            <td class="py-6">MIRAIDO実行委員会</td>
                        </tr>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white"
                                >運営統括責任者</th
                            >
                            <td class="py-6">山崎奈緒美</td>
                        </tr>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white"
                                >所在地</th
                            >
                            <td class="py-6"
                                >〒633-0062<br />奈良県桜井市粟殿1029-6</td
                            >
                        </tr>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white"
                                >電話番号</th
                            >
                            <td class="py-6">0744-48-3603</td>
                        </tr>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white"
                                >メールアドレス</th
                            >
                            <td class="py-6">contact@miraido.net</td>
                        </tr>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white"
                                >お支払い方法</th
                            >
                            <td class="py-6">クレジットカード決済、銀行振込</td>
                        </tr>
                        <tr class="border-b border-white/10">
                            <th class="py-6 pr-8 font-bold text-white"
                                >商品代金以外の必要料金</th
                            >
                            <td class="py-6"
                                >銀行振込手数料、消費税（表示価格は税込価格です）</td
                            >
                        </tr>
                        <tr>
                            <th class="py-6 pr-8 font-bold text-white"
                                >返品・キャンセルについて</th
                            >
                            <td class="py-6"
                                >商品の特性上、原則として返品・キャンセルはお受けしておりません。ただし、当社の不手際による不備があった場合はこの限りではありません。</td
                            >
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Back Link -->
            <div
                class="mt-12 text-center opacity-0 animate-fade-in-up delay-200"
            >
                <a
                    href="/"
                    class="text-accent hover:text-white transition-colors underline decoration-dotted"
                    >Home</a
                >
            </div>
        </div>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";

    gsap.to(".animate-fade-in-up", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
    });
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
</style>
