---
import Layout from "../layouts/Layout.astro";
import DragonAnimation from "../components/DragonAnimation.astro";
---

<Layout
    title="MIRAIDO | プライバシーポリシー"
    description="MIRAIDOプロジェクトの個人情報保護方針。利用者のプライバシー尊重、データ収集の透明性、セキュリティ対策について明記しています。"
>
    <!-- Full-screen Background Animation -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <DragonAnimation />
    </div>

    <main class="relative z-10 min-h-screen py-24 px-4 overflow-hidden">
        <div class="container mx-auto max-w-4xl">
            <!-- Header -->
            <header class="text-center mb-16 opacity-0 animate-fade-in-up">
                <h1
                    class="text-3xl md:text-5xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-teal-400 to-accent mb-6"
                >
                    PRIVACY POLICY
                </h1>
                <p class="text-gray-400">プライバシーポリシー</p>
            </header>

            <!-- Content -->
            <div
                class="bg-slate-900/80 backdrop-blur-md rounded-2xl p-8 md:p-12 border border-white/10 opacity-0 animate-fade-in-up delay-100 prose prose-invert prose-lg max-w-none shadow-2xl"
            >
                <div class="space-y-12">
                    <!-- Section 1 -->
                    <section>
                        <h2
                            class="text-xl md:text-2xl font-bold text-white mb-6 border-l-4 border-accent pl-4 flex items-center"
                        >
                            1. 私たちの姿勢（Introduction）
                        </h2>
                        <div class="bg-white/5 rounded-xl p-6 md:p-8">
                            <p class="leading-relaxed text-gray-300">
                                MIRAIDO（以下「当プロジェクト」）は、テクノロジーとクリエイティビティの融合を目指す活動において、利用者の皆様（クリエイター、サポーター、訪問者）のプライバシーを最も重要な権利の一つとして尊重します。私たちは、法的な義務を果たすだけでなく、信頼されるプラットフォームであるために、データの透明性を約束します。
                            </p>
                        </div>
                    </section>

                    <!-- Section 2 -->
                    <section>
                        <h2
                            class="text-xl md:text-2xl font-bold text-white mb-6 border-l-4 border-accent pl-4 flex items-center"
                        >
                            2. 収集する情報とその利用目的
                        </h2>
                        <div class="bg-white/5 rounded-xl p-6 md:p-8 space-y-4">
                            <p class="text-gray-300">
                                当プロジェクトは、以下の目的のために、必要最小限のデータを収集します。
                            </p>
                            <div class="overflow-x-auto mt-4">
                                <table
                                    class="w-full text-left border-collapse min-w-[600px]"
                                >
                                    <thead>
                                        <tr
                                            class="border-b border-gray-700 bg-white/5"
                                        >
                                            <th
                                                class="py-3 px-4 font-bold text-accent w-1/3"
                                                >データの種類</th
                                            >
                                            <th
                                                class="py-3 px-4 font-bold text-accent"
                                                >利用目的</th
                                            >
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-700">
                                        <tr
                                            class="hover:bg-white/5 transition-colors"
                                        >
                                            <td
                                                class="py-4 px-4 font-bold text-white align-top"
                                                >アクセスログ・Cookie</td
                                            >
                                            <td
                                                class="py-4 px-4 text-gray-300 align-top"
                                            >
                                                <ul
                                                    class="list-disc list-inside space-y-1"
                                                >
                                                    <li>
                                                        サイト体験の改善（ダークモード設定の保存など）
                                                    </li>
                                                    <li>
                                                        人気のコンテンツや技術記事の分析（GA4利用）
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                        <tr
                                            class="hover:bg-white/5 transition-colors"
                                        >
                                            <td
                                                class="py-4 px-4 font-bold text-white align-top"
                                                >メールアドレス</td
                                            >
                                            <td
                                                class="py-4 px-4 text-gray-300 align-top"
                                            >
                                                <ul
                                                    class="list-disc list-inside space-y-1"
                                                >
                                                    <li>問い合わせへの返信</li>
                                                    <li>
                                                        ニュースレターの配信（希望者のみ）
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                        <tr
                                            class="hover:bg-white/5 transition-colors"
                                        >
                                            <td
                                                class="py-4 px-4 font-bold text-white align-top"
                                                >寄付・支援者情報</td
                                            >
                                            <td
                                                class="py-4 px-4 text-gray-300 align-top"
                                            >
                                                <ul
                                                    class="list-disc list-inside space-y-1"
                                                >
                                                    <li>
                                                        支援者へのリターン送付
                                                    </li>
                                                    <li>活動報告の送付</li>
                                                </ul>
                                                <p
                                                    class="mt-2 text-sm text-accent/80"
                                                >
                                                    ※クレジットカード情報は決済代行会社が管理し、当プロジェクトは保持しません。
                                                </p>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                    <!-- Section 3 -->
                    <section>
                        <h2
                            class="text-xl md:text-2xl font-bold text-white mb-6 border-l-4 border-accent pl-4 flex items-center"
                        >
                            3. Cookie（クッキー）と外部送信について
                        </h2>
                        <div class="bg-white/5 rounded-xl p-6 md:p-8 space-y-8">
                            <p class="text-gray-300">
                                当サイトでは、より良い体験を提供するためにCookieを使用しています。
                            </p>

                            <div>
                                <h3
                                    class="text-lg font-bold text-white mb-4 flex items-center"
                                >
                                    <span
                                        class="w-1.5 h-1.5 bg-accent rounded-full mr-2"
                                    ></span>
                                    利用している外部ツール
                                </h3>
                                <ul
                                    class="space-y-4 text-gray-300 pl-4 border-l border-gray-700"
                                >
                                    <li>
                                        <strong class="text-white block mb-1"
                                            >Google Analytics 4:</strong
                                        >
                                        サイトの閲覧状況を分析するために使用します。データは匿名化されており、個人を特定するものではありません。
                                    </li>
                                    <li>
                                        <strong class="text-white block mb-1"
                                            >YouTube / Roblox:</strong
                                        >
                                        埋め込みコンテンツの表示において、各プラットフォームのCookieが使用される場合があります。
                                    </li>
                                </ul>
                            </div>

                            <div
                                class="bg-black/20 rounded-lg p-6 border border-white/5"
                            >
                                <h3
                                    class="text-lg font-bold text-white mb-3 flex items-center"
                                >
                                    <span
                                        class="w-1.5 h-1.5 bg-accent rounded-full mr-2"
                                    ></span>
                                    設定の変更
                                </h3>
                                <p class="mb-4 text-gray-300">
                                    あなたのプライバシー設定は、いつでも変更可能です。
                                </p>
                                <a
                                    href="javascript:Cookiebot.renew()"
                                    class="inline-flex items-center gap-2 bg-accent/10 hover:bg-accent/20 text-accent font-bold py-2 px-6 rounded-full transition-all duration-300 border border-accent/30 hover:shadow-[0_0_15px_rgba(45,212,191,0.3)]"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                                        ></path>
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                        ></path>
                                    </svg>
                                    Cookie設定パネルを開く
                                </a>
                            </div>
                        </div>
                    </section>

                    <!-- Section 4 -->
                    <section>
                        <h2
                            class="text-xl md:text-2xl font-bold text-white mb-6 border-l-4 border-accent pl-4 flex items-center"
                        >
                            4. 情報セキュリティと決済の安全性
                        </h2>
                        <div class="bg-white/5 rounded-xl p-6 md:p-8 space-y-6">
                            <p class="text-gray-300">
                                当プロジェクトは、皆様からの支援（寄付）や個人情報を守るために、以下のセキュリティ対策を講じています。
                            </p>
                            <div class="grid md:grid-cols-3 gap-4">
                                <div
                                    class="bg-black/20 p-4 rounded-lg border border-white/5 text-center"
                                >
                                    <div
                                        class="text-accent text-3xl mb-2 flex justify-center"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-8 w-8"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <h3 class="font-bold text-white mb-2">
                                        SSL/TLS暗号化
                                    </h3>
                                    <p class="text-sm text-gray-400">
                                        サイト内の通信はすべて暗号化されています。
                                    </p>
                                </div>
                                <div
                                    class="bg-black/20 p-4 rounded-lg border border-white/5 text-center"
                                >
                                    <div
                                        class="text-accent text-3xl mb-2 flex justify-center"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-8 w-8"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <h3 class="font-bold text-white mb-2">
                                        決済情報の非保持
                                    </h3>
                                    <p class="text-sm text-gray-400">
                                        Stripe等の決済代行業者で処理され、サーバーに保存しません。
                                    </p>
                                </div>
                                <div
                                    class="bg-black/20 p-4 rounded-lg border border-white/5 text-center"
                                >
                                    <div
                                        class="text-accent text-3xl mb-2 flex justify-center"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-8 w-8"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                            ></path>
                                        </svg>
                                    </div>
                                    <h3 class="font-bold text-white mb-2">
                                        アクセス制限
                                    </h3>
                                    <p class="text-sm text-gray-400">
                                        個人情報へのアクセスを厳格に限定・保護しています。
                                    </p>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- Section 5 -->
                    <section>
                        <h2
                            class="text-xl md:text-2xl font-bold text-white mb-6 border-l-4 border-accent pl-4 flex items-center"
                        >
                            5. 免責事項
                        </h2>
                        <div class="bg-white/5 rounded-xl p-6 md:p-8">
                            <p class="text-gray-300">
                                当サイトからリンクされている外部サイト（GitHub、Roblox、Discord等）におけるプライバシー保護については、当プロジェクトは責任を負いかねます。各プラットフォームのポリシーをご確認ください。
                            </p>
                        </div>
                    </section>

                    <!-- Section 6 -->
                    <section>
                        <h2
                            class="text-xl md:text-2xl font-bold text-white mb-6 border-l-4 border-accent pl-4 flex items-center"
                        >
                            6. お問い合わせ
                        </h2>
                        <div class="bg-white/5 rounded-xl p-6 md:p-8 space-y-4">
                            <p class="text-gray-300">
                                データの取り扱いや、活動内容に関するお問い合わせは、以下の窓口までお願いいたします。
                            </p>
                            <div
                                class="bg-black/20 p-6 rounded-lg border border-white/5 flex flex-col md:flex-row items-center justify-between gap-4"
                            >
                                <div class="text-center md:text-left">
                                    <p class="text-white font-bold text-lg">
                                        MIRAIDO Project 運営事務局
                                    </p>
                                </div>
                                <a
                                    href="/contact"
                                    class="bg-accent hover:bg-accent/80 text-black font-bold py-3 px-8 rounded-full transition-all duration-300 shadow-[0_0_20px_rgba(45,212,191,0.4)] hover:shadow-[0_0_30px_rgba(45,212,191,0.6)]"
                                >
                                    問い合わせフォームへ
                                </a>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- Footer Link -->
                <div
                    class="mt-12 pt-8 border-t border-white/10 flex flex-col items-end gap-2"
                >
                    <p class="text-gray-500 text-sm">
                        最終更新日: 2026年1月26日
                    </p>
                </div>
            </div>

            <!-- Back Link -->
            <div
                class="mt-12 text-center opacity-0 animate-fade-in-up delay-200"
            >
                <a
                    href="/"
                    class="text-accent hover:text-white transition-colors underline decoration-dotted"
                    >Home</a
                >
            </div>
        </div>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";

    gsap.to(".animate-fade-in-up", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
    });
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
</style>
