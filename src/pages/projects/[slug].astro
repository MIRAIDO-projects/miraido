---
import Layout from "../../layouts/Layout.astro";
import DragonAnimation from "../../components/DragonAnimation.astro";
import { getProjects, getProjectDetail } from "../../lib/microcms";
import type { Project } from "../../types/microcms";

// Static Paths
export async function getStaticPaths() {
    const { contents: projects } = await getProjects();
    const paths =
        projects && projects.length > 0
            ? projects.map((item) => ({ params: { slug: item.id } }))
            : [
                  { params: { slug: "1" } },
                  { params: { slug: "2" } },
                  { params: { slug: "3" } },
                  { params: { slug: "4" } },
              ];
    return paths;
}

const { slug } = Astro.params;
const project = await getProjectDetail(slug as string);

// Mock data if API fails
const displayProject =
    project ||
    ({
        id: slug,
        title: "ROBO MISSION",
        description:
            "自律型ロボットで課題を解決する競技。子供たちのプログラミングスキルと問題解決能力を競います。",
        publishedAt: "2025-01-01",
        mainImage: { url: "" },
        category: [{ id: "c1", name: "教育" }] as any,
    } as Project);
---

<Layout
    title={`${displayProject.title} | PROJECTS | MIRAIDO`}
    description={`MIRAIDO PROJECT: ${displayProject.title}`}
>
    <div class="fixed inset-0 z-0 pointer-events-none">
        <DragonAnimation />
    </div>

    <main class="relative z-10 min-h-screen py-24 px-4">
        <div class="container mx-auto max-w-4xl">
            <!-- Header Image -->
            <div
                class="rounded-2xl overflow-hidden aspect-video mb-12 bg-slate-800 relative opacity-0 animate-fade-in-up"
            >
                {
                    displayProject.mainImage ? (
                        <img
                            src={displayProject.mainImage.url}
                            alt={displayProject.title}
                            class="w-full h-full object-cover"
                        />
                    ) : (
                        <div class="absolute inset-0 flex items-center justify-center text-6xl text-white/20">
                            🚀
                        </div>
                    )
                }
                <div
                    class="absolute inset-0 bg-gradient-to-t from-slate-900 via-transparent to-transparent opacity-60"
                >
                </div>

                {/* Category Badges */}
                <div
                    class="absolute top-6 left-6 md:top-8 md:left-8 flex flex-wrap gap-2"
                >
                    {
                        (Array.isArray(displayProject.category)
                            ? displayProject.category
                            : displayProject.category
                              ? [displayProject.category]
                              : []
                        ).map((cat: any) => (
                            <span class="bg-white/90 backdrop-blur-sm text-slate-900 text-sm md:text-base px-4 py-1.5 rounded-full border border-white/20 font-bold shadow-sm">
                                {cat.name}
                            </span>
                        ))
                    }
                </div>

                <div class="absolute bottom-0 left-0 p-8 md:p-12 w-full">
                    <h1
                        class="text-4xl md:text-6xl font-bold text-white mb-4 drop-shadow-lg"
                    >
                        {displayProject.title}
                    </h1>
                </div>
            </div>

            <!-- Content -->
            <div
                class="bg-slate-900/60 border border-white/5 backdrop-blur-md rounded-2xl p-8 md:p-12 opacity-0 animate-fade-in-up delay-200"
            >
                <article class="prose prose-invert prose-lg max-w-none">
                    <p
                        class="text-gray-300 font-light leading-relaxed whitespace-pre-wrap"
                    >
                        {displayProject.description}
                    </p>
                </article>
            </div>

            <!-- Footer Navigation -->
            <div
                class="mt-20 text-center opacity-0 animate-fade-in-up delay-500"
            >
                <a
                    href="/projects"
                    class="inline-flex items-center px-8 py-3 rounded-full border border-white/20 hover:bg-white/10 transition-colors text-sm font-bold tracking-widest gap-2 group"
                >
                    <span
                        class="transform group-hover:-translate-x-1 transition-transform"
                        >←</span
                    >
                    一覧に戻る
                </a>
            </div>
        </div>
    </main>
</Layout>

<script>
    import { gsap } from "gsap";
    const items = document.querySelectorAll(".animate-fade-in-up");
    if (items.length > 0) {
        gsap.to(items, {
            y: 0,
            opacity: 1,
            duration: 1,
            stagger: 0.1,
            ease: "power3.out",
        });
    }
</script>

<style>
    .animate-fade-in-up {
        transform: translateY(2rem);
        opacity: 0;
    }
    :global(.prose h2) {
        color: #0ea5e9;
        border-left: 4px solid #0ea5e9;
        padding-left: 1rem;
        margin-top: 3rem;
    }
    :global(.prose h3) {
        color: #e2e8f0;
        margin-top: 2.5rem;
    }
    :global(.prose strong) {
        color: #fff;
    }
</style>
